{
  "name": "console-hub",
  "version": "0.1.0",
  "description": "Independent Console Hub desktop application",
  "main": "./out/main/index.js",
  "author": "Ryan",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "shoot:hub": "node scripts/shoot-hub.mjs",
    "shoot:handoff": "node scripts/shoot-launch-handoff.mjs",
    "shoot:project-handoff": "node scripts/shoot-project-handoff.mjs",
    "shoot:console-launchers": "node scripts/shoot-console-launchers.mjs",
    "shoot:console-orchestrator": "node scripts/shoot-console-orchestrator.mjs",
    "package": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.2.7"
  }
}
